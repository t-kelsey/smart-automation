# Env vars for running the API locally (`mix phx.server`). Mix does not load .env files itself:
#   cp .env.example .env && set -a && source .env && set +a && mix phx.server

# Extraction pipeline (bem) that pipeline runs are submitted to. The pipeline container publishes
# BEM_PORT (default 8000) on the host: `docker compose up -d pipeline` from the repo root.
# Unset or empty: uploads are stored but runs stay "new" ("No pipeline is configured").
PIPELINE_URL=http://localhost:8000/execute

# Optional
# PORT=4000
# DOCUMENT_STORAGE_DIR=
