# Copy to bem/.env: cp .env.example .env   (read by `python -m pipeline`, `python -m pipeline.server`)

# Elixir API that stage results, reports and boreholes are uploaded to (/api is appended if missing)
BEM_API_URL=http://localhost:4000
# dev keeps results/report/debug files under bem/out, prod writes nothing locally
BEM_ENV=dev
# AI backend (claude_cli) and server settings
# BEM_AI=claude_cli
# BEM_PORT=8000
# BEM_WORKERS=4
# BEM_CHUNK_SIZE=10
