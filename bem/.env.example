# Copy to bem/.env: cp .env.example .env   (read by `python -m pipeline`, `python -m pipeline.server`)

# Elixir API that stage results, reports and boreholes are uploaded to (/api is appended if missing)
BEM_API_URL=http://localhost:4000
# dev keeps results/report/debug files under bem/out, prod writes nothing locally
BEM_ENV=dev
# AI backend (claude_cli | local) and server settings
# BEM_AI=claude_cli
# BEM_PORT=8000
# BEM_WORKERS=4
# BEM_CHUNK_SIZE=10

# Local vision model (provider "local", ADR-0040): Ollama, e.g. `ollama pull qwen3-vl:2b` (4 GB GPU: 2b/4b only)
# BEM_LOCAL_URL=http://localhost:11434
# BEM_LOCAL_MODEL=            # replaces the default model of every step that still names haiku/sonnet/opus
# BEM_LOCAL_TIMEOUT=600       # seconds per request
# BEM_LOCAL_NUM_CTX=8192      # context window; raise only if VRAM allows
# BEM_LOCAL_MAX_SIDE=1100     # px of the longer page side sent to the model
# BEM_LOCAL_MAX_PAGES=4       # pages per request (split/extract fail or truncate beyond this)
# BEM_LOCAL_CHUNK_SIZE=2      # pages per classification call in step 1
