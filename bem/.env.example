# Copy to bem/.env: cp .env.example .env   (read by `python -m pipeline`, `python -m pipeline.server`)

# Elixir API that stage results, reports and boreholes are uploaded to (/api is appended if missing)
BEM_API_URL=http://localhost:4000
# dev keeps results/report/debug files under bem/out, prod writes nothing locally
BEM_ENV=dev
# AI backend: claude_cli (default, needs the logged-in `claude` CLI) or openrouter
# BEM_AI=claude_cli
# OpenRouter (BEM_AI=openrouter): haiku/sonnet/opus map to anthropic/claude-*-4.5; step models containing
# a "/" (e.g. google/gemini-2.5-flash) are used as is; BEM_OPENROUTER_MODEL forces one model for all steps
# OPENROUTER_API_KEY=sk-or-...
# BEM_OPENROUTER_MODEL=
# Server settings
# BEM_PORT=8000
# BEM_WORKERS=4
# BEM_CHUNK_SIZE=10
