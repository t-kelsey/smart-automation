# Copy to .env and adjust: cp .env.example .env
# Everything below is read by docker-compose.yml.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=api_prod

# --- API ---
# Generate with: openssl rand -base64 48   (or `mix phx.gen.secret` in api/)
SECRET_KEY_BASE=change-me-to-a-long-random-string-of-at-least-64-characters-xxxxxxxx
# Hostname or IP your team uses to reach the stack (used for URL generation)
PHX_HOST=localhost
# Load the example boreholes plus generated mock data on every API start (true/false).
# Only earlier seeded/mock rows are replaced; real data is never touched.
SEED_MOCK_DATA=false
# Number of generated mock boreholes when seeding (max 1000000, see the memory note in api/lib/api/mock_data.ex)
MOCK_BOREHOLES=10000
# Host ports published by compose
API_PORT=4001
WEB_PORT=3001

# Pipeline endpoint that uploaded documents are sent to (start it with `--profile bem`).
# Leave empty to only store uploads without processing them.
# PIPELINE_URL=http://pipeline:8000/process

# --- BEM (docker compose run --rm bem ...) ---
# Model pulled by the ollama container and used for extraction
BEM_MODEL_NAME=qwen3.5:2b
# Model server used by bem; the default is the ollama container. Point it elsewhere
# (e.g. http://host.docker.internal:8000/v1 for vLLM on the host) to use an external server.
# BEM_MODEL_BASE_URL=http://ollama:11434/v1
