# Copy to .env and adjust: cp .env.example .env
# Everything below is read by docker-compose.yml.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Same name as the default of config/prod.exs; also the database created in the db container
POSTGRES_DB=api_prod

# --- API ---
# Generate with: openssl rand -base64 48   (or `mix phx.gen.secret` in api/)
SECRET_KEY_BASE=change-me-to-a-long-random-string-of-at-least-64-characters-xxxxxxxx
# Hostname or IP your team uses to reach the stack (used for URL generation)
PHX_HOST=localhost
# Load the example boreholes plus generated mock data on every API start (true/false).
# Only earlier seeded/mock rows are replaced; real data is never touched.
SEED_MOCK_DATA=false
# Number of generated mock boreholes when seeding (max 1000000, see the memory note in api/lib/api/mock_data.ex)
MOCK_BOREHOLES=10000
# Host ports published by compose
API_PORT=4001
WEB_PORT=3001

# Pipeline endpoint that uploaded documents are sent to (default: the pipeline service below).
# Set to an empty value to only store uploads without processing them.
# PIPELINE_URL=http://pipeline:8000/execute

# --- BEM pipeline ---
# Host port of the pipeline container
BEM_PORT=8000
# dev keeps JSON results/report/debug files under bem/out, prod writes nothing locally
BEM_ENV=prod

# AI backend: claude_cli (default, uses the credentials above) or openrouter
BEM_AI=openrouter
# Credentials for the OpenRouter API (used when BEM_AI=openrouter)
OPENROUTER_API_KEY=change-me-to-your-openrouter-api-key
# Optional: force one OpenRouter model for all steps (default: haiku/sonnet map to anthropic/claude-*-4.5)
# BEM_OPENROUTER_MODEL=haiku
# Credentials for the claude CLI inside the pipeline container (one of the two)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=