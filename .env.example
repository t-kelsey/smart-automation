# Copy to .env and adjust: cp .env.example .env
# Everything below is read by docker-compose.yml.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=api_dev

# --- API ---
# Generate with: openssl rand -base64 48   (or `mix phx.gen.secret` in api/)
SECRET_KEY_BASE=change-me-to-a-long-random-string-of-at-least-64-characters-xxxxxxxx
# Hostname or IP your team uses to reach the stack (used for URL generation)
PHX_HOST=localhost
# Host ports published by compose
API_PORT=4000
WEB_PORT=3000
